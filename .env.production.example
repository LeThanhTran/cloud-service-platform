# Copy to .env.production on the Google Cloud VM.
# NEVER commit .env.production.

# Public URL used by CORS and generated ServicePlan QR targets.
# Initial IP deployment example: http://34.123.45.67
# Later, with a domain + HTTPS: https://novacloud.example.com
PUBLIC_BASE_URL=http://YOUR_STATIC_EXTERNAL_IP

# SQL Server SA password. Use a strong unique value.
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_SQL_PASSWORD

# JWT signing key. Use a random value well above 32 characters.
JWT_KEY=CHANGE_ME_RANDOM_JWT_SIGNING_KEY_AT_LEAST_32_CHARS

# This is a public student/demo deployment, not a real customer production system.
# Set true only when you want the three demo roles seeded into a fresh database.
SEED_DEMO_USERS=true
DEMO_USERS_PASSWORD=CHANGE_ME_STRONG_DEMO_PASSWORD
