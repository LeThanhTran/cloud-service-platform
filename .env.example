# Copy this file to .env before running Docker Compose.
# SQL Server password must satisfy SQL Server complexity requirements.
MSSQL_SA_PASSWORD=NovaCloud@2026Docker!

# Development-only demo accounts seeded by the API container.
# Admin  : admin@novacloud.local
# Editor : editor@novacloud.local
# User   : user@novacloud.local
DEMO_USERS_PASSWORD=123456

# JWT signing key for Docker. Use at least 32 characters.
# Replace this value in your private .env file.
JWT_KEY=CHANGE_ME_NOVACLOUD_DOCKER_JWT_KEY_32_CHARS_MINIMUM
